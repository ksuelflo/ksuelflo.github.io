mutate(dis_to_water = pmin(D1,D2,DIS_LAKE, DIS_MAJOR_RIVER, na.rm = TRUE)) %>% mutate(log(POPGPW_2005_40),log(MER2005_40)) %>%
select(-c(D1,D2,DIS_LAKE, DIS_MAJOR_RIVER))
